{
  "name": "dataset-atlas",
  "version": "1.0.0",
  "description": "A map-first atlas for discovering and downloading datasets across domains and regions — Region → Domain → Get in ≤3 clicks.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python3 -m http.server 4173",
    "build:site": "node scripts/build-site.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "validate": "node scripts/validate-catalog.js",
    "refresh": "node scripts/refresh-catalog.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
